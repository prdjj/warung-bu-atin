<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pencatatan Keuangan Warung Bu Atin</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 p-6">
    <div class="max-w-5xl mx-auto">
        <h1 class="text-2xl font-bold mb-2 text-gray-800">Sistem Pencatatan Keuangan Warung Bu Atin</h1>
        <p class="text-gray-600 mb-6">Ringkasan arus kas harian dan daftar transaksi.</p>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
            <div class="bg-white p-4 rounded shadow border-l-4 border-green-500">
                <p class="text-sm text-gray-500">Total Kas Masuk</p>
                <p class="text-xl font-bold text-green-600">Rp <%= totalMasuk.toLocaleString('id-ID') %></p>
            </div>
            <div class="bg-white p-4 rounded shadow border-l-4 border-red-500">
                <p class="text-sm text-gray-500">Total Kas Keluar</p>
                <p class="text-xl font-bold text-red-600">Rp <%= totalKeluar.toLocaleString('id-ID') %></p>
            </div>
            <div class="bg-white p-4 rounded shadow border-l-4 border-blue-500">
                <p class="text-sm text-gray-500">Saldo Kas Bersih</p>
                <p class="text-xl font-bold text-blue-600">Rp <%= saldoKas.toLocaleString('id-ID') %></p>
            </div>
            <div class="bg-white p-4 rounded shadow border-l-4 border-yellow-500">
                <p class="text-sm text-gray-500">Total Piutang (Kasbon)</p>
                <p class="text-xl font-bold text-yellow-600">Rp <%= totalPiutang.toLocaleString('id-ID') %></p>
            </div>
        </div>

        <div class="flex justify-between items-center mb-4">
            <h2 class="text-xl font-semibold text-gray-700">Daftar Transaksi</h2>
            <a href="/tambah" class="bg-blue-600 text-white px-4 py-2 rounded shadow hover:bg-blue-700">+ Catat Transaksi</a>
        </div>

        <div class="bg-white rounded shadow overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-200 text-gray-700 text-sm">
                        <th class="p-3">Tanggal</th>
                        <th class="p-3">Keterangan</th>
                        <th class="p-3">Jenis</th>
                        <th class="p-3">Status</th>
                        <th class="p-3">Jumlah</th>
                        <th class="p-3 text-center">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 text-sm">
                    <% if (transaksi.length === 0) { %>
                        <tr><td colspan="6" class="p-4 text-center text-gray-500">Belum ada transaksi.</td></tr>
                    <% } else { %>
                        <% transaksi.forEach(item => { %>
                            <tr>
                                <td class="p-3"><%= new Date(item.tanggal).toLocaleDateString('id-ID') %></td>
                                <td class="p-3"><%= item.keterangan %></td>
                                <td class="p-3">
                                    <span class="px-2 py-1 rounded text-xs font-semibold <%= item.jenis === 'masuk' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                                        <%= item.jenis.toUpperCase() %>
                                    </span>
                                </td>
                                <td class="p-3">
                                    <span class="px-2 py-1 rounded text-xs font-semibold <%= item.status_piutang === 'lunas' ? 'bg-blue-100 text-blue-800' : 'bg-yellow-100 text-yellow-800' %>">
                                        <%= item.status_piutang.toUpperCase() %>
                                    </span>
                                </td>
                                <td class="p-3 font-medium">Rp <%= parseFloat(item.jumlah).toLocaleString('id-ID') %></td>
                                <td class="p-3 text-center">
                                    <form action="/hapus/<%= item.id %>" method="POST" onsubmit="return confirm('Yakin hapus transaksi ini?');">
                                        <button type="submit" class="text-red-600 hover:underline">Hapus</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>